{% if template.name == 'index' %}
  <!-- WebSite Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": {{ shop.url | append: '/' | json }},
  "name": {{ shop.name | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
  <!-- Organization Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "logo": {{ shop.brand.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% if shop.email or shop.phone %}
    "contactPoint": {
      "@type": "ContactPoint",
      {% if shop.phone %}
      "telephone": {{ shop.phone | json }},
      {% endif %}
      {% if shop.email %}
      "email": {{ shop.email | json }},
      {% endif %}
      "contactType": "customer service"
    },
    {% endif %}
    "sameAs": [
      {% if settings.social_facebook != blank %}{{ settings.social_facebook | json }},{% endif %}
      {% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}
    ]
  }
  </script>
  {% endif %}

    {% case template.name %}
      {% when 'product' %}
        {% render 'schema-product', product: product %}
      {% when 'collection' %}
        {% render 'schema-collection', collection: collection %}
    {% endcase %}

    {% case template.suffix %}
      {% when 'care-instructions-2' %}
        {% render 'schema-care-instructions-2' %}
    {% endcase %}
    <script>
      window.jdgmSettings = { autoInstall: false };
    </script>

    {{ 'ew-custom.js' | asset_url | script_tag }}

