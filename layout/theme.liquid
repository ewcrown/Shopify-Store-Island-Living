  {% if product.template_suffix == 'with-addons' %}
  <script>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof window.addonVariants === 'undefined' || !Array.isArray(window.addonVariants)) return;

      const form = document.querySelector('form[action^="/cart/add"]');
      if (!form) return;

      form.addEventListener('submit', function (e) {
        const selectedAddon = form.querySelector('input[name="properties[Add-on]"]:checked');
        if (!selectedAddon || selectedAddon.value.includes('Base Only')) return;

        const addonTitle = selectedAddon.value.split('(')[0].replace('With', '').trim();
        const addon = window.addonVariants.find(v => v.title.trim() === addonTitle);
        if (!addon || !addon.id) return;

        // Delay to allow main product to process first
        setTimeout(() => {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: addon.id, quantity: 1 })
          })
          .then(res => res.json())
          .then(data => {
            console.log('Addon added:', data);
            if (typeof window.Spurit !== 'undefined' && typeof Spurit.global.atc !== 'undefined') {
              const cartDrawer = document.querySelector('cart-drawer');
              if (cartDrawer && typeof cartDrawer.openMenuDrawer === 'function') {
                cartDrawer.openMenuDrawer();
              }
            }
          })
          .catch(err => console.error('Addon failed:', err));
        }, 500);
      });
    });
  </script>
